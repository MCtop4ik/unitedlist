{
  "name": "gd-united-list",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build && npm --workspace backend run build",
    "typecheck": "npm --workspace frontend run typecheck && npm --workspace backend run typecheck && tsc -p tsconfig.node.json",
    "lint": "npm --workspace frontend run lint && npm --workspace backend run lint",
    "test": "npm --workspace frontend run test && npm --workspace backend run test",
    "test:e2e": "npm --workspace frontend run test:e2e",
    "dev:mock": "tsx mock/server.ts",
    "seed:mock": "tsx scripts/seed-mock.ts",
    "refresh:levels": "tsx scripts/refresh-levels.ts",
    "refresh:completions": "tsx scripts/refresh-completions.ts",
    "validate:levels": "tsx scripts/validate-levels.ts",
    "correct:records": "tsx scripts/correct-records.ts",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "e2e:backend": "tsx backend/tests/e2e-server.ts",
    "test:e2e:backend": "npm --workspace frontend run test:e2e:backend",
    "snapshot:sources": "tsx scripts/snapshot-sources.ts",
    "restore:gddl": "tsx scripts/restore-gddl.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "express": "^4.21.2",
    "json-server": "^0.17.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "type": "module"
}
